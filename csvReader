using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;

class Program
{
    static void Main(string[] args)
    {
        string inputCsvFilePath = "input.csv"; // Path to your CSV file
        string outputPolicyNumbersFilePath = "outputPolicyNumbers.txt"; // Output for policy numbers
        string inputPoliciesFilePath = "inputPolicies.txt"; // Input text file with policy numbers
        string outputIdsFilePath = "outputIds.txt"; // Output for IDs

        try
        {
            // Task 1: Extract policy numbers and write to a text file
            ExtractPolicyNumbers(inputCsvFilePath, outputPolicyNumbersFilePath);

            // Task 2: Find IDs of given policy numbers
            FindIdsForPolicies(inputCsvFilePath, inputPoliciesFilePath, outputIdsFilePath);

            Console.WriteLine("Processing completed successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }
    }

    /// <summary>
    /// Reads the CSV file and writes all valid policy numbers to a text file.
    /// </summary>
    static void ExtractPolicyNumbers(string csvFilePath, string outputFilePath)
    {
        var policyNumbers = new HashSet<string>();
        using (var reader = new StreamReader(csvFilePath))
        {
            string headerLine = reader.ReadLine(); // Read header line
            if (headerLine == null) throw new Exception("CSV file is empty.");

            string[] headers = ParseCsvLine(headerLine);
            int policyIndex = Array.IndexOf(headers, "Associate Policy or RetentionNumber");

            if (policyIndex == -1) throw new Exception("Required column not found in CSV.");

            while (!reader.EndOfStream)
            {
                string line = reader.ReadLine();
                if (string.IsNullOrWhiteSpace(line)) continue;

                string[] fields = ParseCsvLine(line);
                if (policyIndex >= fields.Length) continue;

                string policyValue = fields[policyIndex].Trim();
                if (decimal.TryParse(policyValue, out _)) // Check if it's numeric
                {
                    policyNumbers.Add(policyValue);
                }
            }
        }

        File.WriteAllText(outputFilePath, string.Join(",", policyNumbers));
        Console.WriteLine("Policy numbers written to: " + outputFilePath);
    }

    /// <summary>
    /// Reads a text file containing policy numbers and finds corresponding IDs from the CSV.
    /// </summary>
    static void FindIdsForPolicies(string csvFilePath, string policiesFilePath, string outputFilePath)
    {
        // Load policy numbers from input file
        var policyNumbers = new HashSet<string>(File.ReadAllLines(policiesFilePath).Select(p => p.Trim()));

        var matchingIds = new List<string>();

        using (var reader = new StreamReader(csvFilePath))
        {
            string headerLine = reader.ReadLine(); // Read header line
            if (headerLine == null) throw new Exception("CSV file is empty.");

            string[] headers = ParseCsvLine(headerLine);
            int idIndex = Array.IndexOf(headers, "ID");
            int policyIndex = Array.IndexOf(headers, "Associate Policy or RetentionNumber");

            if (idIndex == -1 || policyIndex == -1)
                throw new Exception("Required columns not found in CSV.");

            while (!reader.EndOfStream)
            {
                string line = reader.ReadLine();
                if (string.IsNullOrWhiteSpace(line)) continue;

                string[] fields = ParseCsvLine(line);
                if (idIndex >= fields.Length || policyIndex >= fields.Length) continue;

                string idValue = fields[idIndex].Trim();
                string policyValue = fields[policyIndex].Trim();

                if (policyNumbers.Contains(policyValue))
                {
                    matchingIds.Add(idValue);
                }
            }
        }

        File.WriteAllText(outputFilePath, string.Join(Environment.NewLine, matchingIds));
        Console.WriteLine("IDs of policies written to: " + outputFilePath);
    }

    /// <summary>
    /// Parses a CSV line considering basic escaping for commas within quotes.
    /// </summary>
    static string[] ParseCsvLine(string line)
    {
        var result = new List<string>();
        bool insideQuotes = false;
        var currentField = new List<char>();

        foreach (char c in line)
        {
            if (c == ',' && !insideQuotes)
            {
                result.Add(new string(currentField.ToArray()));
                currentField.Clear();
            }
            else if (c == '"')
            {
                insideQuotes = !insideQuotes;
            }
            else
            {
                currentField.Add(c);
            }
        }

        result.Add(new string(currentField.ToArray())); // Add the last field
        return result.ToArray();
    }
}
